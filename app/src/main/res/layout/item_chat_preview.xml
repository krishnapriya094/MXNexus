<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical">

    <!-- Avatar with online indicator -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp">

        <TextView
            android:id="@+id/tvChatInitial"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/gradient_avatar_bg"
            android:gravity="center"
            android:text="U"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <!-- Online dot -->
        <View
            android:id="@+id/viewOnlineDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/online_indicator"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- Name, role, last message -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <!-- Name row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvChatName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="User Name"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_dark"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvChatTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="now"
                android:textColor="@color/text_hint"
                android:textSize="11sp"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

        <!-- Role/company -->
        <TextView
            android:id="@+id/tvChatRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="1dp"/>

        <!-- Last message row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/tvChatLastMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="No messages yet"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <!-- Unread badge -->
            <TextView
                android:id="@+id/tvUnreadCount"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/unread_badge_bg"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:visibility="gone"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
