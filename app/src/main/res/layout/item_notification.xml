<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical">

    <!-- Avatar initial -->
    <TextView
        android:id="@+id/tvNotifInitial"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/gradient_avatar_bg"
        android:gravity="center"
        android:text="U"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <!-- Message + time -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvNotificationMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="User liked your post"
            android:textColor="#1A1A2E"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.3"/>

        <TextView
            android:id="@+id/tvNotificationTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2h ago"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginTop="3dp"/>

        <!-- Accept/Decline for connection requests -->
        <LinearLayout
            android:id="@+id/layoutNotifActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNotifAccept"
                android:layout_width="80dp"
                android:layout_height="32dp"
                android:text="Accept"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                app:cornerRadius="16dp"
                app:backgroundTint="#FF00CC"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNotifDecline"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="80dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:text="Decline"
                android:textSize="12sp"
                android:textColor="#888888"
                app:cornerRadius="16dp"
                app:strokeColor="#DDDDDD"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Unread dot -->
    <View
        android:id="@+id/viewNotifUnread"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/unread_badge_bg"
        android:layout_marginStart="8dp"
        android:visibility="gone"/>

</LinearLayout>